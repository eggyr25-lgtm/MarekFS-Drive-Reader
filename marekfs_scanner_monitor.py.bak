    # Create monitor
    monitor = ScannerMonitor(enable_host_scanning=False)
    
    # Show status
    print(f"Status: {monitor.get_status()}")
    
    # Test quarantine
    print("\nTesting quarantine system...")
    test_file = tempfile.NamedTemporaryFile(delete=False, suffix=".exe")
    test_file.write(b"test malware content")
    test_file.close()
    
    quarantine_id = monitor.quarantine_manager.quarantine_file(
        test_file.name, "Test-Detection", {"status": "malicious"}
    )
    print(f"Quarantine ID: {quarantine_id}")
    
    # Test restore
    print("\nTesting restore...")
    success, msg = monitor.quarantine_manager.restore_file(quarantine_id)
    print(f"Restore result: {success} - {msg}")
    
    # Cleanup
    if os.path.exists(test_file.name):
        os.remove(test_file.name)
    
    print("\nQuarantine list:", monitor.quarantine_manager.get_quarantine_list())
    print("Whitelist:", monitor.whitelist_manager.get_all())